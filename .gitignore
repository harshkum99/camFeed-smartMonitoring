# Media & data
*.mp4
*.mkv
*.avi
*.ts
*.h264
# ...but *.ts above means MPEG transport streams, not TypeScript. Without this, the console's
# TypeScript sources were silently never committed and a clean checkout could not build.
!console/src/**/*.ts
!console/*.config.ts
*.jpg
*.jpeg
*.png
!docs/**/*.png
!web/**/public/**
data/
media/
recordings/
snapshots/

